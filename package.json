{
  "name": "yomukana",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "corpus:fetch": "bun scripts/corpus/sources.ts",
    "corpus:build": "bun scripts/corpus/build.ts",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run format:check && bun run lint && bun run check:dashes && bun run check:messages && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:fast": "prettier --check --cache . && eslint --cache . && bun run check:dashes && bun run check:messages",
    "check:dashes": "bun scripts/check-no-dashes.ts",
    "check:messages": "bun scripts/check-messages.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "icons": "bun scripts/icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db/migrate.ts && neon data-api refresh-schema --branch dev",
    "db:migrate:production": "bun --env-file=.env.prod.local scripts/db/migrate.ts && neon data-api refresh-schema --branch production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@inlang/paraglide-js": "^2.18.2",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.48.0",
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@neon/functions": "^0.11.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sglkc/kuromoji": "^1.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "bits-ui": "^2.18.0",
    "cn": "^0.3.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "naughty-words": "^1.2.0",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "idb": "^8.0.3",
    "mode-watcher": "^1.1.0",
    "ts-fsrs": "^5.4.1",
    "uqr": "^0.1.3"
  }
}
