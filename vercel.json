{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/@:username",
      "destination": "/200.html"
    },
    {
      "source": "/join/:code",
      "destination": "/200.html"
    },
    {
      "source": "/display/:code",
      "destination": "/200.html"
    }
  ]
}
