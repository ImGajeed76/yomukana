{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/_app/immutable/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, immutable, max-age=31536000" }]
    }
  ],
  "rewrites": [
    {
      "source": "/@:username",
      "destination": "/200"
    },
    {
      "source": "/join/:code",
      "destination": "/200"
    },
    {
      "source": "/display/:code",
      "destination": "/200"
    }
  ]
}
